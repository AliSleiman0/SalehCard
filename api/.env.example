MONGO_URI=mongodb://localhost:27017
DB_NAME=salehcard
PORT=8080
JWT_SECRET=change_me_in_production
# Session token lifetimes (Go duration strings). Defaults: 90 days each.
# ACCESS_TOKEN_TTL=2160h
# REFRESH_TOKEN_TTL=2160h
GOOGLE_CLIENT_ID=
ALLOWED_ORIGINS=http://localhost:5173
ENV=development
# Timezone for day-grained admin dashboard figures ("today" revenue/orders, the
# daily revenue chart). IANA name; defaults to UTC. Set to the operating market
# in prod, e.g. Asia/Beirut, so day boundaries match local midnight.
BUSINESS_TZ=

# --- OTP SMS ---------------------------------------------------------------
# Active provider: monty (Lebanon) | twilio (international) | log (dev, logs code)
SMS_PROVIDER=log

# Monty Mobile (sms.montymobile.com/API/SendSMS) — required when SMS_PROVIDER=monty.
# MONTY_SENDER_ID must be a registered/approved Source on the account.
MONTY_BASE_URL=https://sms.montymobile.com
MONTY_USERNAME=
MONTY_API_ID=
MONTY_ACCESS_TOKEN=
MONTY_SENDER_ID=SalehCard
MONTY_CAMPAIGN=

# Twilio — required when SMS_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# OTP tuning (optional; defaults shown).
# DEFAULT_COUNTRY_CODE=+961
# OTP_LENGTH=6
# OTP_TTL=5m
# OTP_RESEND_INTERVAL=60s
# OTP_MAX_ATTEMPTS=5

# --- Push notifications ------------------------------------------------------
# Active provider: fcm (Firebase Cloud Messaging) | log (dev, logs the push)
PUSH_PROVIDER=log

# FCM (HTTP v1) — required when PUSH_PROVIDER=fcm. Provide the Firebase
# service-account key either inline (minified one-line JSON; Azure app setting)
# or as a file path (local dev). FCM_PROJECT_ID is optional (derived from the
# service account when empty).
FCM_CREDENTIALS_JSON=
FCM_CREDENTIALS_FILE=
FCM_PROJECT_ID=

# --- Storage (product image uploads) ----------------------------------------
# Active provider: azure (Azure Blob Storage) | local (dev, writes to disk)
STORAGE_PROVIDER=local

# Azure Blob Storage — required when STORAGE_PROVIDER=azure. Connection-string
# auth against a public-read ("blob" access level) container.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=product-images

# Local adapter (dev) — files land in UPLOADS_DIR and are served back by the
# API itself under /uploads/*; PUBLIC_BASE_URL prefixes the returned URLs.
UPLOADS_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8090

# --- On-chain USDT payments (TRC20) ------------------------------------------
# Chain reader: trongrid (real chain) | stub (dev — auto-confirms every intent
# after USDT_STUB_DELAY, so the whole flow runs with zero chain access).
# The feature is ENABLED when EXACTLY ONE of USDT_XPUB / USDT_ADDRESS is set
# (both set refuses to boot in every env — the two addressing modes are
# mutually exclusive):
#   USDT_XPUB    → derived mode: a unique deposit address per payment, derived
#                  watch-only from the account xpub. The clean design.
#   USDT_ADDRESS → shared mode: ONE fixed TRC20 address for every payment;
#                  payments are matched by an exact salted amount (sub-cent
#                  digits added server-side), and transfers matching nothing
#                  land in the admin reconciliation queue (Payments →
#                  Unmatched deposits). Use when only a plain wallet address
#                  is available (no xpub).
# SAFETY: outside development, stub + either mode refuses to boot (it would
# confirm unpaid payments).
USDT_PROVIDER=stub

# Derived mode: watch-only BIP44 account xpub (m/44'/195'/0'). Deposit
# addresses derive from it server-side; the mnemonic/xprv must NEVER touch the
# server or this repo. Dev: any valid xpub works with the stub provider (see
# DEVOPS-TODO for how to generate one offline).
USDT_XPUB=

# Shared mode: one fixed TRC20 deposit address (base58, starts with T).
# Validated at boot — a typo'd address would send customer funds somewhere
# unrecoverable.
USDT_ADDRESS=

# TronGrid — required when USDT_PROVIDER=trongrid.
TRONGRID_API_KEY=
# TRONGRID_BASE_URL=https://api.trongrid.io
# Token contract override (default = mainnet USDT TR7NHq...).
# USDT_CONTRACT=

# --- BEP20 (BSC) second network — additive to the TRC20 mode above ----------
# Setting USDT_BEP20_ADDRESS enables USDT on BNB Smart Chain as a second
# network the customer can pick. Always shared-address mode (same salted-amount
# matching + reconciliation queue as USDT_ADDRESS); independent of the TRC20
# vars — BEP20-only also works. NOTE: BEP20 USDT has 18 decimals on-chain; the
# adapter normalizes to the same micro-USDT unit internally.
# Chain reader: jsonrpc (real chain, free public BSC nodes, no key — the
# recommended provider) | etherscan (real chain, Etherscan V2 multichain API —
# its FREE tier does NOT cover BSC/chainid 56, a PAID plan is required) | stub
# (dev). SAFETY: outside development, stub + address set refuses to boot, and
# an unknown provider name refuses to boot too.
USDT_BEP20_PROVIDER=stub
# One fixed BEP20 deposit address (0x + 40 hex). Validated at boot (EIP-55 when
# mixed-case) — a typo'd address would send customer funds somewhere
# unrecoverable.
USDT_BEP20_ADDRESS=
# Public BSC JSON-RPC nodes for the jsonrpc provider (CSV; defaults shown).
# Both are verified to serve filtered eth_getLogs over ≥4000-block ranges —
# the canonical bsc-dataseed.* nodes DO NOT (they reject getLogs outright).
# BSC_RPC_ENDPOINTS=https://rpc-bsc.48.club,https://bsc-mainnet.nodereal.io/v1/64a9df0874fb4a93b9d0a3849de012d3
# Etherscan — required when USDT_BEP20_PROVIDER=etherscan (paid plan only).
ETHERSCAN_API_KEY=
# ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
# Token contract override (default = BSC mainnet USDT 0x55d398...).
# USDT_BEP20_CONTRACT=
# How settled a BSC transfer must be before it counts (~seconds of latency).
# USDT_BEP20_MIN_CONFIRMATIONS=15

# Tuning (defaults shown; expiry/interval/grace/stub-delay apply to both networks).
# USDT_INTENT_EXPIRY=30m       # customer payment window
# USDT_WATCH_INTERVAL=25s      # watcher tick
# USDT_LATE_GRACE=168h         # keep scanning expired-unpaid addresses
# USDT_STUB_DELAY=15s          # stub auto-pay delay (dev)
# RATE_LIMIT_PAYMENT_CREATE_MAX=10
# RATE_LIMIT_PAYMENT_CREATE_WINDOW=1m
# RATE_LIMIT_PAYMENT_POLL_MAX=60
# RATE_LIMIT_PAYMENT_POLL_WINDOW=1m

# --- Mobile Bridge (Lebanese recharge automation) --------------------------
# Off by default: until BRIDGE_ENABLED=true, recharge orders park for manual
# admin completion (no device is contacted). The device polls over HTTPS with a
# per-device token issued from the admin Bridge page.
BRIDGE_ENABLED=false
# BRIDGE_STUB auto-succeeds queued commands after BRIDGE_STUB_DELAY so a dev with
# no phone still sees recharge orders complete. Refused outside development.
# BRIDGE_STUB=false
# BRIDGE_STUB_DELAY=10s

# Command lease lifecycle (defaults shown).
# BRIDGE_LEASE_TTL=3m            # how long a device holds a leased command
# BRIDGE_MAX_ATTEMPTS=3         # lease attempts before a command is failed
# BRIDGE_QUEUE_TIMEOUT=30m      # fail a command no device ever picked up
# BRIDGE_REAPER_INTERVAL=30s
# BRIDGE_POLL_INTERVAL=5s        # advertised to the device
# BRIDGE_HEARTBEAT_INTERVAL=5m   # advertised to the device
# BRIDGE_MAX_SMS_PER_HALF_HOUR=25  # client-side pacing (Android SEND_SMS ceiling)
# Reply matching (comma-separated, case-insensitive; calibrate on real SIMs).
# BRIDGE_SUCCESS_PATTERNS=success,transferred
# BRIDGE_FAILURE_PATTERNS=fail,do not have,insufficient

# Operator SMS/USSD templates, shortcodes, and fees. Placeholders: {phone},
# {amount}, {card}, {code}. Defaults are the known Lebanese values — confirm on a
# live SIM before go-live.
# BRIDGE_TOUCH_BALANCE_USSD=*220#
# BRIDGE_ALFA_BALANCE_USSD=*11#
# BRIDGE_TOUCH_RECHARGE_TEMPLATE=*300*{phone}#{card}
# BRIDGE_TOUCH_TRANSFER_TEMPLATE={phone}T{amount}
# BRIDGE_TOUCH_TRANSFER_DEST=1199
# BRIDGE_ALFA_RECHARGE_TEMPLATE={phone}R{code}
# BRIDGE_ALFA_RECHARGE_DEST=1313
# BRIDGE_ALFA_TRANSFER_TEMPLATE={phone}T{amount}
# BRIDGE_ALFA_TRANSFER_DEST=1399
# BRIDGE_TOUCH_MIN_BALANCE=20
# BRIDGE_ALFA_MIN_BALANCE=20
# BRIDGE_TOUCH_MESSAGE_FEE=0.16
# BRIDGE_ALFA_MESSAGE_FEE=0.14
